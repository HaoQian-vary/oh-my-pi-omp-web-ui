{
  "name": "omp-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "本地 Web 界面,驱动 Oh My Pi (omp) 编码代理(基于 omp --mode rpc)",
  "scripts": {
    "dev": "vite web --config vite.config.mjs",
    "build": "vite build web --config vite.config.mjs",
    "preview": "vite preview web --config vite.config.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
